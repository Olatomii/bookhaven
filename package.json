{
  "name": "bookhaven-standalone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["client"],
  "scripts": {
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
